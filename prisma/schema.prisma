// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Model สำหรับ Collection 'Product' ใน MongoDB
model Product {
  // 1. ฟิลด์ ID: ใช้ ObjectId สำหรับ MongoDB
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // 2. ข้อมูลสินค้า
  name        String   @unique // ชื่อสินค้าต้องไม่ซ้ำกัน
  description String?  
  price       Float    
  stock       Int     
  
  // 3. เวลา
  createdAt   DateTime @default(now()) 
  updatedAt   DateTime @updatedAt     
}

enum Role {
  USER
  ADMIN
  EDITOR
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  password    String   
  name        String?  
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
